# ==========================================================================
# English for Community — Backend environment
# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env.
# (Trên Render: đặt các biến này trong tab Environment, không dùng file .env.)
# ==========================================================================

# --- MongoDB (BẮT BUỘC) ---------------------------------------------------
# Code đọc biến MONGO_URI (KHÔNG phải MONGODB_URI).
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/english_community?retryWrites=true&w=majority
# Tên database. Mặc định 'english_community'. Đặt biến này để ép đúng DB,
# tránh Mongoose rơi về DB 'test' khi URI thiếu /db ở path.
MONGO_DB_NAME=english_community

# --- Server ---------------------------------------------------------------
# 'production' trên Render (bắt buộc JWT secret an toàn + log 'combined').
NODE_ENV=development
# Cổng HTTP (Render tự inject PORT của nó).
PORT=3000
# Số lớp proxy tin tưởng (Render = 1) để express-rate-limit lấy đúng IP client.
TRUST_PROXY_HOPS=1

# --- JWT (BẮT BUỘC) -------------------------------------------------------
# Code đọc JWT_ACCESS_SECRET (fallback sang JWT_SECRET) và JWT_REFRESH_SECRET.
JWT_ACCESS_SECRET=thay-bang-chuoi-ngau-nhien-dai
JWT_REFRESH_SECRET=thay-bang-chuoi-ngau-nhien-dai-khac

# --- CORS -----------------------------------------------------------------
# Danh sách origin web (teacher/admin) được phép, cách nhau bằng dấu phẩy.
# Để trống = cho phép mọi origin (chỉ nên dùng khi dev). VD:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# --- Cloudinary (upload avatar/audio) -------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase Admin (FCM push) --------------------------------------------
# Base64 của file service-account JSON.
FIREBASE_CONFIG_BASE64=

# --- AI providers ---------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
# OPENAI_API_KEY / GEMINI key nếu bật các tính năng tương ứng.

# --- Email / SMTP (OTP, reset mật khẩu) -----------------------------------
# Gmail: dùng App Password, host smtp.gmail.com, port 465 (secure=true).
# LƯU Ý: Render chặn port 25 → dùng 587/465, hoặc API (SendGrid/Mailgun/Resend).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=English for Community

# --- (Tùy chọn) Google Classroom / LTI ------------------------------------
# GOOGLE_CLASSROOM_CLIENT_ID=
# GOOGLE_CLASSROOM_CLIENT_SECRET=
# GOOGLE_CLASSROOM_REDIRECT_URI=
# LTI_CLIENT_ID=
# LTI_PLATFORM_ISSUER=

# --- (Chỉ dùng khi seed dữ liệu demo — npm run seed:*) --------------------
# Các script seed yêu cầu password qua env (không có default hardcode):
# SEED_ADMIN_PASSWORD=
# SEED_STUDENT_PASSWORD=
# TEACHER_SEED_EMAIL= / TEACHER_SEED_USERNAME= / TEACHER_SEED_PASSWORD=
