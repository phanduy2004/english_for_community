@startuml E4C_Database_Full
' PHU LUC — Schema day du field (32 collection, 7 trang)
' Cho dev / tra cuu chi tiet. Bao cao Word dung bo 4 file:
'   database-overview.puml, database-domain-core.puml,
'   database-domain-classroom-exam.puml, database-domain-learning.puml
' PlantText: Refresh -> Export PDF (7 trang) hoac PNG tung trang

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontSize 9
skinparam classFontSize 9
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

title Trang 1/7 — User va Phan quyen

class User <<Entity>> {
  +_id : ObjectId
  +phone : String
  +email : String
  +password : String
  +avatarUrl : String
  +fullName : String
  +username : String
  +role : String
  +dateOfBirth : Date
  +bio : String
  +gender : String
  +isVerified : Boolean
  +goal : String
  +cefr : String
  +dailyMinutes : Number
  +reminder : Object
  +dailyLessonGoal : Number
  +dailyActivityProgress : Number
  +dailyProgressDate : String
  +totalPoints : Number
  +level : Number
  +currentStreak : Number
  +strictCorrection : Boolean
  +language : String
  +timezone : String
  +isOnline : Boolean
  +lastActivityDate : Date
  +isBanned : Boolean
  +banExpiresAt : Date
  +banReason : String
  +_destroy : Boolean
  +fcmTokens : String[]
  +createdAt : Date
  +updatedAt : Date
}

class Notification <<Entity>> {
  +_id : ObjectId
  +recipientId : ObjectId
  +senderId : ObjectId
  +type : String
  +title : String
  +message : String
  +data : Object
  +isRead : Boolean
  +createdAt : Date
}

class Report <<Entity>> {
  +_id : ObjectId
  +user : ObjectId
  +type : String
  +title : String
  +description : String
  +images : String[]
  +deviceInfo : Object
  +status : String
  +adminResponse : String
  +createdAt : Date
}

User "1" --> "0..*" Notification
User "0..1" --> "0..*" Notification
User "1" --> "0..*" Report

